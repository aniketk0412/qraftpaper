DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
AUTH_SECRET="replace-with-a-random-32-plus-character-secret"
# Public site origin — used for canonical URLs, sitemap, robots and OG images.
NEXT_PUBLIC_SITE_URL="https://qraftpaper.vercel.app"
OPENROUTER_API_KEY="sk-or-v1-..."
# AI models — any tool-calling model on OpenRouter. Defaults to Claude Haiku (cheap).
# For higher question-craft quality at similar cost, try google/gemini-2.5-flash;
# for top quality (pricier) anthropic/claude-sonnet-4.6. Confirm slugs at
# https://openrouter.ai/models
OPENROUTER_GENERATION_MODEL="anthropic/claude-haiku-4.5"
OPENROUTER_EXTRACTION_MODEL="anthropic/claude-haiku-4.5"
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
LEMONSQUEEZY_VARIANT_EDUCATOR=""
LEMONSQUEEZY_VARIANT_DEPARTMENT=""
# Cloudflare Turnstile (signup bot check). Leave blank to disable the captcha.
# Get keys at https://dash.cloudflare.com → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
